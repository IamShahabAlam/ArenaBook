<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8+ adaptive icon. Each phone applies its own mask (circle, squircle, teardrop...);
     the stadium sits inside the central safe zone so it is never clipped.
     monochrome = Android 13+ "themed icons" (recoloured by the system to match the wallpaper). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>